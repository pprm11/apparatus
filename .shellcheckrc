# Read by shellcheck from the directory of each checked file upwards (CI, pre-commit and `ci/gates.py`).
# lib.sh is sourced and has no shebang: name the dialect instead of disabling SC2148.
shell=bash

# SC2088 (lib.sh tilde_path): the quoted "~/" is the literal text Claude Code permission rules use.
disable=SC2088

# SC2034 (sync.sh EGO): variable assigned and never read. Dead code, content fix left to the owner of sync.sh.
# Remove this line together with that assignment.
disable=SC2034
